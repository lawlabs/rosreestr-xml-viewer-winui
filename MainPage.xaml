<Page x:Class="RosreestrViewer.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:RosreestrViewer"
    AllowDrop="True" DragOver="Page_DragOver" Drop="Page_Drop">
    <Grid x:Name="LayoutRoot" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Loaded="Page_Loaded" SizeChanged="Root_SizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <CommandBar x:Name="Commands" DefaultLabelPosition="Right" Background="{ThemeResource SubtleFillColorTransparentBrush}" HorizontalContentAlignment="Left" AutomationProperties.AutomationId="Commands">
            <AppBarButton Icon="OpenFile" Label="Открыть" Click="Open_Click" AutomationProperties.AutomationId="OpenFiles" ToolTipService.ToolTip="Открыть XML и ZIP (Ctrl+O)">
                <AppBarButton.KeyboardAccelerators><KeyboardAccelerator Key="O" Modifiers="Control"/></AppBarButton.KeyboardAccelerators>
            </AppBarButton>
            <AppBarButton Icon="Folder" Label="Папка" Click="Folder_Click" AutomationProperties.AutomationId="OpenFolder"/>
            <AppBarSeparator/>
            <AppBarButton x:Name="PdfButton" Icon="Print" Label="PDF / печать" Click="Pdf_Click" IsEnabled="False" AutomationProperties.AutomationId="ExportPdf"/>
            <AppBarButton x:Name="CsvButton" Icon="Save" Label="Реестр CSV" Click="Csv_Click" IsEnabled="False" AutomationProperties.AutomationId="ExportCsv"/>
            <AppBarButton Icon="Switch" Label="Сравнить" Click="Compare_Click" AutomationProperties.AutomationId="CompareDocs" ToolTipService.ToolTip="Выберите две выписки с Ctrl в списке"/>
            <AppBarButton Icon="Map" Label="НСПД" Click="Map_Click" AutomationProperties.AutomationId="OpenMap"/>
            <CommandBar.SecondaryCommands>
                <AppBarButton Icon="Play" Label="Демонстрационный набор" Click="Demo_Click" AutomationProperties.AutomationId="LoadDemo"/>
                <AppBarButton Icon="List" Label="Списки кадастровых номеров" Click="Lists_Click" AutomationProperties.AutomationId="CadLists"/>
                <AppBarButton Icon="Refresh" Label="Открыть последнюю сессию" Click="Restore_Click" AutomationProperties.AutomationId="RestoreSession"/>
                <AppBarButton Icon="Copy" Label="Сохранить исходный документ" Click="SaveOriginal_Click" AutomationProperties.AutomationId="SaveOriginal"/>
                <AppBarButton Icon="Map" Label="Экспорт схемы SVG" Click="Svg_Click" AutomationProperties.AutomationId="ExportSvg"/>
                <AppBarButton Icon="Document" Label="Сохранить печатную форму HTML" Click="SaveFormHtml_Click" AutomationProperties.AutomationId="SavePrintFormHtml"/>
                <AppBarButton Icon="Library" Label="Шаблоны печатной формы" Click="Templates_Click" AutomationProperties.AutomationId="PrintFormTemplates"/>
                <AppBarButton Icon="Accept" Label="Проверить по локальной XSD" Click="ValidateSchema_Click" AutomationProperties.AutomationId="ValidateSchema"/>
                <AppBarButton Icon="Globe" Label="Проверить подпись на Госуслугах" Click="Signature_Click" AutomationProperties.AutomationId="VerifySignature"/>
                <AppBarButton Icon="Switch" Label="Переключить тему" Click="Theme_Click" AutomationProperties.AutomationId="SwitchTheme"/>
                <AppBarButton Icon="Cancel" Label="Отменить импорт" Click="Cancel_Click" AutomationProperties.AutomationId="CancelImport"/>
                <AppBarButton Icon="Clear" Label="Очистить рабочий список" Click="Clear_Click" AutomationProperties.AutomationId="ClearWorkspace"/>
                <AppBarButton Icon="Help" Label="О приложении и форматах" Click="About_Click" AutomationProperties.AutomationId="AboutApp"/>
            </CommandBar.SecondaryCommands>
        </CommandBar>
        <InfoBar x:Name="Notice" Grid.Row="1" Margin="16,0,16,8" IsOpen="False" IsClosable="True" AutomationProperties.AutomationId="Notice"/>
        <Grid x:Name="WorkspaceGrid" Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition x:Name="LibraryColumn" Width="308"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid x:Name="LibraryPane" Padding="16,16,12,8" Background="{ThemeResource LayerFillColorDefaultBrush}">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="Мои выписки" Style="{StaticResource SubtitleTextBlockStyle}"/>
                <TextBlock x:Name="LibraryCount" Grid.Row="1" Margin="0,4,0,16" Text="Откройте XML или ZIP" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBox x:Name="SearchBox" Grid.Row="2" Header="Поиск в выписках" PlaceholderText="Номер, адрес, правообладатель…" TextChanged="Search_TextChanged" Margin="0,0,0,12" AutomationProperties.AutomationId="SearchDocuments"/>
                <ListView x:Name="DocumentsList" Grid.Row="3" ItemsSource="{x:Bind VisibleDocuments, Mode=OneTime}" SelectionMode="Extended" SelectionChanged="Documents_SelectionChanged" HorizontalContentAlignment="Stretch" AutomationProperties.AutomationId="DocumentsList" AutomationProperties.Name="Список выписок">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:DocumentListItem">
                            <Grid Padding="0,8" RowSpacing="4">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <TextBlock Text="{x:Bind DisplayNumber, Mode=OneTime}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Grid.Row="1" Text="{x:Bind Subtitle, Mode=OneTime}" MaxLines="2" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}"/>
                                <TextBlock Grid.Row="2" Text="{x:Bind Kind, Mode=OneTime}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock Grid.Row="4" Text="Ctrl + щелчок — выбрать две выписки для сравнения" TextWrapping="Wrap" Margin="0,12,0,8" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </Grid>
            <Grid Grid.Column="1" x:Name="DetailPane">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid Padding="24,12,24,8" ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock x:Name="DocumentTitle" Text="Выписки ЕГРН" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" AutomationProperties.AutomationId="DocumentTitle"/><TextBlock x:Name="DocumentSubtitle" Text="XML · архивы · графика · реестр" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" AutomationProperties.AutomationId="DocumentSubtitle"/></StackPanel>
                    <Button Grid.Column="1" Content="Пример" Click="Demo_Click" VerticalAlignment="Center" AutomationProperties.AutomationId="DemoButton"/>
                </Grid>
                <NavigationView x:Name="ViewModes" Grid.Row="1" PaneDisplayMode="Top" IsSettingsVisible="False" IsBackButtonVisible="Collapsed" IsPaneToggleButtonVisible="False" SelectionChanged="ViewMode_Changed" AutomationProperties.AutomationId="ViewModes">
                    <NavigationView.MenuItems>
                        <NavigationViewItem x:Name="PrintFormMode" Content="Печатная форма" Tag="form" Icon="Print" AutomationProperties.AutomationId="ModePrintForm"/>
                        <NavigationViewItem x:Name="OriginalPdfMode" Content="PDF из пакета" Tag="originalPdf" Icon="Document" IsEnabled="False" AutomationProperties.AutomationId="ModeOriginalPdf"/>
                        <NavigationViewItem x:Name="SummaryMode" Content="Карточка" Tag="summary" Icon="Document" AutomationProperties.AutomationId="ModeSummary"/>
                        <NavigationViewItem Content="Схема" Tag="geometry" Icon="Map" AutomationProperties.AutomationId="ModeGeometry"/>
                        <NavigationViewItem Content="Вложения" Tag="attachments" Icon="Attach" AutomationProperties.AutomationId="ModeAttachments"/>
                        <NavigationViewItem Content="Поля XML" Tag="fields" Icon="List" AutomationProperties.AutomationId="ModeFields"/>
                        <NavigationViewItem Content="Исходник" Tag="source" Icon="Edit" AutomationProperties.AutomationId="ModeSource"/>
                    </NavigationView.MenuItems>
                </NavigationView>
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Spacing="8" Margin="16,0,16,8">
                        <InfoBar x:Name="FormInfo" IsOpen="True" IsClosable="False" Visibility="Collapsed" AutomationProperties.AutomationId="PrintFormInfo"/>
                        <ComboBox x:Name="OriginalPdfPicker" Header="Связанный PDF" SelectionChanged="OriginalPdf_Changed" Visibility="Collapsed" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="OriginalPdfPicker"/>
                    </StackPanel>
                    <WebView2 x:Name="Preview" Grid.Row="1" AutomationProperties.AutomationId="DocumentPreview" AutomationProperties.Name="Просмотр выписки"/>
                    <Grid x:Name="AttachmentPane" Grid.Row="1" Visibility="Collapsed" Padding="24">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <CommandBar DefaultLabelPosition="Right" Background="{ThemeResource SubtleFillColorTransparentBrush}" AutomationProperties.AutomationId="AttachmentCommands">
                            <AppBarButton Icon="Download" Label="Загрузить по ссылкам XML" Click="Download_Click" AutomationProperties.AutomationId="DownloadGraphics"/>
                            <AppBarButton Icon="View" Label="Просмотр" Click="AttachmentPreview_Click" AutomationProperties.AutomationId="PreviewAttachment"/>
                            <AppBarButton Icon="Save" Label="Сохранить вложение" Click="SaveAttachment_Click" AutomationProperties.AutomationId="SaveAttachment"/>
                        </CommandBar>
                        <TextBlock Grid.Row="1" Text="Подпись, готовый PDF и графические файлы. Для удалённых ссылок нужна отдельная загрузка." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,16"/>
                        <ListView x:Name="AttachmentsList" Grid.Row="2" SelectionMode="Single" AutomationProperties.AutomationId="AttachmentsList" AutomationProperties.Name="Вложения выписки"/>
                    </Grid>
                    <StackPanel x:Name="PreviewError" Grid.Row="1" Visibility="Collapsed" Margin="32" Spacing="12"><TextBlock Text="Предпросмотр недоступен" Style="{StaticResource SubtitleTextBlockStyle}"/><TextBlock x:Name="PreviewErrorText" TextWrapping="Wrap"/><Button Content="Повторить" Click="RetryPreview_Click" AutomationProperties.AutomationId="RetryPreview"/></StackPanel>
                </Grid>
            </Grid>
        </Grid>
        <Grid Grid.Row="3" Padding="16,8" Background="{ThemeResource LayerFillColorDefaultBrush}" ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <ProgressRing x:Name="BusyRing" Width="18" Height="18" IsActive="False" Visibility="Collapsed"/>
            <TextBlock x:Name="StatusText" Grid.Column="1" Text="Готово · файлы обрабатываются локально" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" AutomationProperties.AutomationId="StatusText"/>
            <TextBlock x:Name="LocalLabel" Grid.Column="2" Text="ЛОКАЛЬНО" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </Grid>
    </Grid>
</Page>
